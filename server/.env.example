DATABASE_URL=postgresql://...
JWT_SECRET=your-256-bit-secret
JWT_REFRESH_SECRET=your-256-bit-refresh-secret
ENCRYPTION_KEY=64-hex-character-key-for-aes-256
UPLOADTHING_SECRET=sk_live_...
UPLOADTHING_APP_ID=...
UPLOAD_CALLBACK_SECRET=your-upload-callback-hmac-secret
APP_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
# Optional comma-separated production front-end origins (also accepts CLIENT_URL)
CORS_ORIGINS=
PORT=3001
NODE_ENV=development
# Upstash Redis (required in production; optional in development — rate limits fall back to allow)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx
